#!/bin/sh
# Blocks a push to the trunk unless this repo's checks pass.
#
# The gate is one optional file, `scripts/checks.sh`. A repo with nothing to
# check has no such file and this hook waves the push through; a repo that
# grows a test, a linter or a build adds it there and gets the gate for free.
# Never bypass a failing check with --no-verify.
#
# Arm it on a fresh clone (once per machine — .claude/hooks/session-start.sh
# does it for you):
#   git config core.hooksPath .githooks

[ -x scripts/checks.sh ] || exit 0

# The trunk: the remote's own answer first, then whichever name exists.
trunk=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
if [ -z "$trunk" ]; then
  for b in main master; do
    if git rev-parse --verify --quiet "refs/remotes/origin/$b" >/dev/null; then trunk=$b; break; fi
  done
fi
trunk=${trunk:-main}

pushing_trunk=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "refs/heads/$trunk") pushing_trunk=1 ;;
  esac
done

[ "$pushing_trunk" -eq 0 ] && exit 0

echo "pre-push: $trunk is the published branch — running scripts/checks.sh"
if ! ./scripts/checks.sh; then
  echo "pre-push: checks FAILED — push blocked" >&2
  exit 1
fi

echo "pre-push: checks passed"
exit 0
